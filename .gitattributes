# Normalise line endings so Windows checkouts don't churn the diff.
* text=auto eol=lf

*.php   text diff=php
*.sql   text
*.md    text
*.sh    text eol=lf
bin/migrate text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary

# Keep generated/vendored code out of language stats and PR diffs.
vendor/**   linguist-vendored
docs/**     linguist-documentation
